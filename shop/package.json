{
  "name": "chrona-shop",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.7.9",
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "node -e \"const p=require.resolve('react-dev-utils/getCSSModuleLocalIdent');const f=require(p);require.cache[p].exports=(...a)=>f(...a).replace(/_+/g,'-');require('react-scripts/scripts/start')\"",
    "build": "node -e \"const p=require.resolve('react-dev-utils/getCSSModuleLocalIdent');const f=require(p);require.cache[p].exports=(...a)=>f(...a).replace(/_+/g,'-');require('react-scripts/scripts/build')\""
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
